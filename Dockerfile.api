# Optional container build for the separate Express API service.
# Build from the repository root: docker build -f Dockerfile.api -t voice-memory-api .
FROM node:22-bookworm-slim
RUN corepack enable && corepack prepare pnpm@10.8.1 --activate
WORKDIR /app
COPY . .
RUN pnpm install --no-frozen-lockfile && pnpm --filter @workspace/api-server build
ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000
CMD ["pnpm", "--filter", "@workspace/api-server", "start"]
